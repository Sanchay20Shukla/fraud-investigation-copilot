DATABASE_URL=sqlite:///data/processed/copilot.db
# PostgreSQL: set all three URLs; keep read and audit roles separate.
# DATABASE_URL=postgresql+psycopg://copilot_admin:local_admin@localhost:5433/copilot
# READ_DATABASE_URL=postgresql+psycopg://copilot_reader:local_reader@localhost:5433/copilot
# AUDIT_DATABASE_URL=postgresql+psycopg://copilot_audit:local_audit@localhost:5433/copilot
RETRIEVAL_MODE=lexical
# ARTIFACTS_DIR=models
# semantic uses sentence-transformers/all-MiniLM-L6-v2 (download on first use).
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
API_BASE_URL=http://127.0.0.1:8010
